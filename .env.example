# Interview agent (Hugging Face Inference Providers): reads the profile, writes every question,
# scores answers, reviews code and writes the report. Required; there is no demo mode.
AGENT_PROVIDERS=huggingface,gemini,groq
HUGGINGFACE_API_KEY=
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MONGODB_URI=
MONGODB_DATABASE=bnb_interview
CARTESIA_API_KEY=

# Code execution: judge0 (default, sandboxed) or local (offline dev only, not a sandbox)
CODE_RUNNER=judge0
# The free public Judge0 CE needs no key. RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com plus JUDGE0_API_KEY.
# Self-hosted: JUDGE0_URL=http://localhost:2358 and JUDGE0_API_KEY=<X-Auth-Token>, if you set one.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
FRONTEND_URL=http://localhost:3000
# Extra browser origins, comma-separated. Production example: https://bnb.vercel.app
# CORS_ORIGINS=
# Optional regex matched against the browser Origin. Example: https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=
# Required to create an interviewer account. Leave empty locally and interviewer signup stays closed.
ADMIN_ACCESS_CODE=
# Hosts inject PORT. Local `uv run main.py` ignores it and stays on 127.0.0.1:8000 with reload.
# Next.js proxies /api to this API. Override in frontend/.env.local when the API is not on port 8000.
# API_URL=http://127.0.0.1:8000
