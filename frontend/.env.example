# Public API origin. Leave empty for local dev so the browser uses the Next.js /api rewrite.
# Set this on the host before the production build. Origin only: no trailing slash, no /api suffix.
# Example: https://bnb-api.up.railway.app
NEXT_PUBLIC_API_URL=

# Server-side rewrite target used when NEXT_PUBLIC_API_URL is empty. Local default is http://127.0.0.1:8000.
# API_URL=http://127.0.0.1:8000
